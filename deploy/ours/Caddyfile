# TLS for the host (Let's Encrypt, automatic). See README.md in this folder.
{
	# No client addresses in the logs: no site has an access log, and this one carries them too.
	log {
		exclude http.log.error
	}
}

{$PUBLISH_DOMAIN} {
	# The privacy notice: a static page, nothing dynamic.
	handle /privacy {
		root * /srv/site
		rewrite * /privacy.html
		file_server
	}

	handle {
		# A little over the largest blob (20 MiB); the host enforces its own limits as well.
		request_body {
			max_size 21MB
		}
		# Caddy puts the client's address in X-Forwarded-For (replacing any the client sent),
		# which the host trusts because PUBLISH_TRUST_PROXY is set.
		reverse_proxy publish:8080
	}
}
