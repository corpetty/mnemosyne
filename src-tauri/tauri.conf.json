{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mnemosyne",
  "version": "0.8.0",
  "identifier": "com.corpetty.mnemosyne",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "bash scripts/build-all.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Mnemosyne",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend": "backend"
    },
    "linux": {
      "deb": {
        "depends": [
          "pipewire-bin",
          "ffmpeg"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": [
          "/usr/bin/pw-record",
          "/usr/bin/pw-dump",
          "/usr/bin/pw-cli",
          "/usr/bin/ffmpeg"
        ]
      }
    },
    "externalBin": [
      "binaries/mnemosyne-uv"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2QUJGNTQwMzBFREYzNkMKUldSczgrMHdRUFdycHB6SU9QWUtWMmVFT1cvWUF0amtIbzZzZ3hMazAvWmJKeUNJNktERzBlUkMK",
      "endpoints": [
        "https://github.com/corpetty/mnemosyne/releases/latest/download/latest.json"
      ]
    }
  }
}
